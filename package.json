{
  "name": "reelori-local",
  "version": "0.4.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "export:public": "node scripts/export-public.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs --history",
    "server": "node apps/local-service/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspace apps/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "43.7.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
